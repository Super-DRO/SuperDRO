<resources>
    <string name="service_channel_name">Verbindungen</string>
    <string name="service_disconnect_all">Alle trennen</string>
    <plurals name="service_title_online">
        <item quantity="one">%1$d Maschine online</item>
        <item quantity="other">%1$d Maschinen online</item>
    </plurals>
    <string name="service_title_none_online">Keine Maschine ist online</string>
    <plurals name="service_offline_remembered">
