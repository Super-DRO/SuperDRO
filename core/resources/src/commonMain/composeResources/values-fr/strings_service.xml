<!-- The strings of the connection service: the notification, the start at boot, the battery optimization request, and the background warning. -->
<resources>
    <string name="service_channel_name">Connexions</string>
    <string name="service_disconnect_all">Tout déconnecter</string>
    <plurals name="service_title_online">
        <item quantity="one">%1$d machine en ligne</item>
        <item quantity="other">%1$d machines en ligne</item>
    </plurals>
    <string name="service_title_none_online">Aucune machine n'est en ligne</string>
    <plurals name="service_offline_remembered">
