-- The inspection log of a workspace. The sequence starts at 1
-- in each workspace. `payload_json` holds the typed MeasurementLogEntry. A workspace delete
-- removes its log.

import kotlin.Int;
import kotlin.time.Instant;

CREATE TABLE measurement_log (
    id TEXT NOT NULL PRIMARY KEY,
    workspace_id TEXT NOT NULL REFERENCES workspace(id) ON DELETE CASCADE,
    sequence INTEGER AS Int NOT NULL,
    verb TEXT NOT NULL,
    payload_json TEXT NOT NULL,
    created_on TEXT AS Instant NOT NULL,
    UNIQUE (workspace_id, sequence)
);

selectForWorkspace:
SELECT * FROM measurement_log WHERE workspace_id = ? ORDER BY sequence;

countForWorkspace:
SELECT count(*) FROM measurement_log WHERE workspace_id = ?;

maxSequence:
SELECT max(sequence) AS value FROM measurement_log WHERE workspace_id = ?;

insert:
INSERT INTO measurement_log (id, workspace_id, sequence, verb, payload_json, created_on)
VALUES (?, ?, ?, ?, ?, ?);

deleteById:
DELETE FROM measurement_log WHERE id = ?;

deleteForWorkspace:
DELETE FROM measurement_log WHERE workspace_id = ?;
